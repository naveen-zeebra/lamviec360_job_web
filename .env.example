# ==============================================================================
# LàmViệc360 Jobseeker Web - Environment Configuration Example
# ==============================================================================

# Active Environment: local | develop | production
NEXT_PUBLIC_ENVIRONMENT=local

# Dev Server Port
PORT=3001

# ------------------------------------------------------------------------------
# Local Environment (Default fallback when NEXT_PUBLIC_ENVIRONMENT=local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_LOCAL_API_TARGET=http://localhost:8001
NEXT_PUBLIC_LOCAL_BASE_URL=http://localhost:8001/api/v1/jobseeker
NEXT_PUBLIC_LOCAL_S3_IMAGE_BASE_URL=http://localhost:8001/uploads
NEXT_PUBLIC_LOCAL_EMPLOYER_URL=http://localhost:3002

# ------------------------------------------------------------------------------
# Develop Environment (Active when NEXT_PUBLIC_ENVIRONMENT=develop)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEVELOP_API_TARGET=https://devapi.lamviec360.com
NEXT_PUBLIC_DEVELOP_BASE_URL=https://devapi.lamviec360.com/api/v1/jobseeker
NEXT_PUBLIC_DEVELOP_S3_IMAGE_BASE_URL=https://devapi.lamviec360.com/uploads
NEXT_PUBLIC_DEVELOP_EMPLOYER_URL=https://devcompany.lamviec360.com

# ------------------------------------------------------------------------------
# Production Environment (Active when NEXT_PUBLIC_ENVIRONMENT=production)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PRODUCTION_API_TARGET=https://api.lamviec360.com
NEXT_PUBLIC_PRODUCTION_BASE_URL=https://api.lamviec360.com/api/v1/jobseeker
NEXT_PUBLIC_PRODUCTION_S3_IMAGE_BASE_URL=https://api.lamviec360.com/uploads
NEXT_PUBLIC_PRODUCTION_EMPLOYER_URL=https://company.lamviec360.com

# ------------------------------------------------------------------------------
# Global Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_TIMEOUT=30000

# Optional Direct Overrides (uncomment to explicitly override active environment)
# NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1/jobseeker
# NEXT_PUBLIC_EMPLOYER_URL=http://localhost:3002
